        "fig, axes = plt.subplots(2, 2, figsize=(16, 8))\n",
        "axes = axes.flatten()\n",
        "\n",
        "def plot_kde_thuc(ax, de_1, de_2, de_3, title, color):\n",
        "        sns.kdeplot(\n",
        "            x=de_1,\n",
        "            color=color, fill=False, alpha=0.7, label=\"Đề 1\", ax=ax\n",
        "        )\n",
        "        sns.kdeplot(\n",
        "            x=de_2,\n",
        "            color=color, fill=False, alpha=1.0, linestyle=\"--\", label=\"Đề 2\", ax=ax\n",
        "        )\n",
        "        sns.kdeplot(\n",
        "            x=de_3,\n",
        "            color=color, fill=False, alpha=1.0, linestyle=\":\", label=\"Đề 3\", ax=ax\n",
        "        )\n",
        "\n",
        "        ax.set_xlabel('Số câu đúng')\n",
        "        ax.set_xlim(1, 300)\n",
        "        ax.set_ylabel(\"Mật độ\")\n",
        "        ax.set_title(f\"{title}\")\n",
        "        ax.legend()\n",
        "\n",
        "plot_kde_thuc(axes[0], df_true_1['TrueTV'], df_true_2['TrueTV'], df_true_3['TrueTV'], \"Tiếng Việt\", color='b')\n",
        "plot_kde_thuc(axes[1], df_true_1['TrueTA'], df_true_2['TrueTA'], df_true_3['TrueTA'], \"Tiếng Anh\", color='r')\n",
        "plot_kde_thuc(axes[2], df_true_1['TrueTO'], df_true_2['TrueTO'], df_true_3['TrueTO'], \"Toán\", color='y')\n",
        "plot_kde_thuc(axes[3], df_true_1['TrueKH'], df_true_2['TrueKH'], df_true_3['TrueKH'], \"Tư duy khoa học\", color='g')\n",
        "\n",
        "plt.suptitle('Phổ điểm thô theo từng phần thi', y=0.98)\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    },
