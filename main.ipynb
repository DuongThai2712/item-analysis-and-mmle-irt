   "source": [
    "fig, axes = plt.subplots(2, 2, figsize=(16, 8))\n",
    "axes = axes.flatten()\n",
    "\n",
    "def plot_kde(ax, de_1, de_2, de_3, title, color):\n",
    "        sns.kdeplot(\n",
    "            x=de_1, \n",
    "            color=color, fill=False, alpha=0.7, label=\"Đề 1\", ax=ax\n",
    "        )\n",
    "        sns.kdeplot(\n",
    "            x=de_2, \n",
    "            color=color, fill=False, alpha=1.0, linestyle=\"--\", label=\"Đề 2\", ax=ax\n",
    "        )\n",
    "        sns.kdeplot(\n",
    "            x=de_3, \n",
    "            color=color, fill=False, alpha=1.0, linestyle=\":\", label=\"Đề 3\", ax=ax\n",
    "        )\n",
    "\n",
    "        ax.set_xlabel('Số câu đúng')\n",
    "        ax.set_xlim(1, 30)\n",
    "        ax.set_ylabel(\"Mật độ\")\n",
    "        ax.set_title(f\"{title}\")\n",
    "        ax.legend()\n",
    "\n",
    "plot_kde(axes[0], df_TV1[\"Raw\"], df_TV2[\"Raw\"], df_TV3[\"Raw\"], \"Tiếng Việt\", color='b')\n",
    "plot_kde(axes[1], df_TA1[\"Raw\"], df_TA2[\"Raw\"], df_TA3[\"Raw\"], \"Tiếng Anh\", color='r')\n",
    "plot_kde(axes[2], df_TO1[\"Raw\"], df_TO2[\"Raw\"], df_TO3[\"Raw\"], \"Toán\", color='y')\n",
    "plot_kde(axes[3], df_KH1[\"Raw\"], df_KH2[\"Raw\"], df_KH3[\"Raw\"], \"Tư duy khoa học\", color='g')\n",
    "\n",
    "plt.suptitle('Phổ điểm thô theo từng phần thi', y=0.98)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
