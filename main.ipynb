    "def a_category(disc):\n",
    "    if disc <= 0:\n",
    "        return 'Kém'\n",
    "    elif disc <= 0.20:\n",
    "        return 'Chưa tốt'\n",
    "    elif disc <= 0.40:\n",
    "        return 'Chấp nhận được'\n",
    "    elif disc <= 0.60:\n",
    "        return 'Tương đối tốt'\n",
    "    elif disc <= 0.80:\n",
    "        return 'Tốt'\n",
    "    elif disc <= 1.0:\n",
    "        return 'Rất tốt'\n",
    "    else:\n",
    "        return 'Quá tốt'\n",
    "    \n",
    "disc_1['Phân loại'] = disc_1['D-Index'].apply(a_category)\n",
    "disc_2['Phân loại'] = disc_2['D-Index'].apply(a_category)\n",
    "disc_3['Phân loại'] = disc_3['D-Index'].apply(a_category)"
