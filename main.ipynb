    "list_names = [\n",
    "    [\"Tiếng Việt\", \"Tiếng Anh\", \"Toán\", \"Tư duy khoa học\" ],\n",
    "    [\"Tiếng Việt\", \"Tiếng Anh\", \"Toán\", \"Tư duy khoa học\" ],\n",
    "    [\"Tiếng Việt\", \"Tiếng Anh\", \"Toán\", \"Tư duy khoa học\" ]\n",
    "]\n",
    "\n",
    "all_df_groups = [\n",
    "    [df_TV1, df_TA1, df_TO1, df_KH1],\n",
    "    [df_TV2, df_TA2, df_TO2, df_KH2],\n",
    "    [df_TV3, df_TA3, df_TO3, df_KH3]\n",
    "]\n",
    "\n",
    "# --- tạo subplot ---\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "\n",
    "for ax, df_group, names, title in zip(\n",
    "    axes,\n",
    "    all_df_groups,\n",
    "    list_names,\n",
    "    [\"Đề 1\", \"Đề 2\", \"Đề 3\"]\n",
    "):\n",
    "    for df, name in zip(df_group, names):\n",
    "        # lọc dữ liệu đồng nhất với plot_theta_se\n",
    "        mask = df['Null'] < 30\n",
    "        theta = df.loc[mask, 'Theta']\n",
    "        theta_se = plot_theta_se(df)\n",
    "\n",
    "        sns.scatterplot(\n",
    "            x=theta,\n",
    "            y=theta_se,\n",
    "            ax=ax,\n",
    "            label=name,\n",
    "            s=25\n",
    "        )\n",
    "\n",
    "    ax.set_xlabel(\"Theta\")\n",
    "    ax.set_ylabel(\"SE(Theta)\")\n",
    "    ax.set_title(title)\n",
    "    ax.legend(title=\"Môn\")\n",
    "    ax.set_xlim(-6,6)\n",
    "    ax.legend(loc='upper center')\n",
    "\n",
    "plt.suptitle('Sai số chuẩn ước lượng năng lực thí sinh', y=0.95)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
