        "fig, axes = plt.subplots(ncols=3, figsize=(24, 4))\n",
        "\n",
        "# ===== ĐỀ 1 =====\n",
        "sns.countplot(data=diff_1, x='Phân loại', palette='GnBu_d',\n",
        "              ax=axes[0], hue='Phần thi', order=order_kho)\n",
        "axes[0].set_title('Đề 1')\n",
        "\n",
        "for p in axes[0].patches:\n",
        "    height = p.get_height()\n",
        "    if height > 0:\n",
        "        axes[0].annotate(f'{int(height)}',\n",
        "                         (p.get_x() + p.get_width() / 2, height),\n",
        "                         ha='center', va='bottom', fontsize=10)\n",
        "\n",
        "axes[0].set_ylabel('Số lượng')\n",
        "axes[0].set_xlabel(None)\n",
        "\n",
        "\n",
        "# ===== ĐỀ 2 =====\n",
        "sns.countplot(data=diff_2, x='Phân loại', palette='YlGn_d',\n",
        "              ax=axes[1], hue='Phần thi', order=order_kho)\n",
        "axes[1].set_title('Đề 2')\n",
        "\n",
        "for p in axes[1].patches:\n",
        "    height = p.get_height()\n",
        "    if height > 0:\n",
        "        axes[1].annotate(f'{int(height)}',\n",
        "                         (p.get_x() + p.get_width() / 2, height),\n",
        "                         ha='center', va='bottom', fontsize=10)\n",
        "\n",
        "axes[1].set_ylabel('Số lượng')\n",
        "axes[1].set_xlabel(None)\n",
        "\n",
        "\n",
        "# ===== ĐỀ 3 =====\n",
        "sns.countplot(data=diff_3, x='Phân loại', palette='OrRd_d',\n",
        "              ax=axes[2], hue='Phần thi', order=order_kho)\n",
        "axes[2].set_title('Đề 3')\n",
        "\n",
        "for p in axes[2].patches:\n",
