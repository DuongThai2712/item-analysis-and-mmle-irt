   "source": [
    "# hàm phân loại độ nhiễu câu hỏi\n",
    "def label_distract(data):\n",
    "    scale = 0\n",
    "    for col in data.drop(columns='Ans').index:  # bỏ qua cột đáp án đúng\n",
    "        if data[col] == data['Ans']:\n",
    "            continue\n",
    "        else:\n",
    "            scale += (data[col]<0)\n",
    "    if scale == 4:\n",
    "        return \"Tốt\"\n",
    "    elif scale == 3:\n",
    "        return \"Bình thường\"\n",
    "    elif scale == 2:\n",
    "        return \"Yếu\"\n",
    "    else:  \n",
    "        return \"Kém\""
   ]
  },
